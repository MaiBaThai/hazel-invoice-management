rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Allow whitelisted access control check
    match /system_configs/access_control {
      allow read: if request.auth != null;
      allow write: if false; // Only via Console/Admin
    }
    
    // 2. User-scoped data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 3. Legacy collections (Keep access for migration cleanup)
    match /customers/{document=**} { allow read, write: if request.auth != null; }
    match /invoices/{document=**} { allow read, write: if request.auth != null; }
    match /expenses/{document=**} { allow read, write: if request.auth != null; }
    match /configs/{document=**} { allow read, write: if request.auth != null; }
  }
}
